			/* one mode only: the R36S alternates below do not fit this panel */
			/delete-node/ timing1;
			/delete-node/ timing2;
		};
	};
};

&timing0 {
	clock-frequency = <58000000>;
	hactive = <640>;
	vactive = <480>;
	hfront-porch = <300>;
	hsync-len = <200>;
	hback-porch = <300>;
	vfront-porch = <173>;	/* was 17: 78.2 Hz; 60.03 Hz, same pixel clock */
	vsync-len = <5>;
	vback-porch = <13>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <1>;
};
