		panel-exit-sequence = [
			05 00 01 28
			05 00 01 10
		];
		display-timings {
			/* one mode only: the R36S alternates below do not fit this panel */
			/delete-node/ timing1;
			/delete-node/ timing2;
		};
	};
};

&timing0 {
	clock-frequency = <34000000>;
	hactive = <720>;
	vactive = <720>;
	hfront-porch = <16>;
	hsync-len = <5>;
	hback-porch = <11>;
	vfront-porch = <16>;
	vsync-len = <5>;
	vback-porch = <11>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <0>;
};

&rk817 {
	battery {
		design_capacity = <2832>;
		design_qmax = <3115>;
	};
};

/* the speaker runs through an external amplifier (stock "use-ext-amplifier") */
&rk817 {
	codec {
		use-ext-amplifier;
	};
};
