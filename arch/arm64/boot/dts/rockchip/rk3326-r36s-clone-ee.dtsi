// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * EXPERIMENTAL - not tested on hardware by andr36oid.
 *
 * Common part of the "EE clone" R36S boards: the clones that ship with
 * EmuELEC 4.7 (Linux 4.4 BSP) on the card, e.g. G80C/G80CA/G80D, K36,
 * HG36, R36S-V12 "clone" variants, R36S-V20, GR36 / R36 Ultra.
 *
 * The wiring comes from the stock DTBs dumped from these consoles, cross
 * checked with the andr36oid ports by K4uanGP (Andr36oid-dtb-for-Clones)
 * and the ArkOS ports in southoz's dArkOSRE-R36.
 *
 * Board defaults here are the G80 wiring:
 *   analog stick mux enable  GPIO2_B3
 *   LCD reset                GPIO3_D3
 *   LCD power switch         GPIO3_A3
 * rk3326-r36s-clone-ee-k36.dtsi changes these for the K36/HG36 wiring.
 * A board DTS picks one of the two and adds a panel.
 */

#include "rk3326-r36s-android.dtsi"

/* Volume keys are on an ADC ladder (SARADC channel 2), not on GPIOs. */
/delete-node/ &gpio_keys;

/ {
	model = "R36S clone, EE board (experimental)";

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 2>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <15000>;
		};

		vol-down-key {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <295000>;
		};
	};

	/* 5 V for the USB host port */
	vcc_host: vcc-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc_host";
		gpio = <&gpio3 RK_PA4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vccsys>;
	};

	/* LCD logic supply, switched by a GPIO instead of RK817 LDO8 */
	vcc_lcd_sw: vcc-lcd-sw {
		compatible = "regulator-fixed";
		regulator-name = "vcc18_lcd0";
		gpio = <&gpio3 RK_PA3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vccsys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&joypad {
	/*
	 * No rumble motor, so the gamepad doesn't offer rumble. pwms stays: the
	 * older joypad driver in the resizer and recovery kernels oopses when
	 * it is missing.
	 */
	andr36oid,no-rumble;
	amux-a-gpios = <&gpio2 RK_PC0 GPIO_ACTIVE_LOW>;
	amux-b-gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_LOW>;
	amux-en-gpios = <&gpio2 RK_PB3 GPIO_ACTIVE_LOW>;
	/* the mux channels are wired in a different order than on the R36S */
	amux-channel-mapping = <2 3 1 0>;

	sw1 { gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>; };	/* up */
	sw2 { gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>; };	/* down */
	sw3 { gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>; };	/* left */
	sw4 { gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>; };	/* right */
	sw5 { gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>; };	/* A */
	sw6 { gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>; };	/* B */
	sw7 { gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>; };	/* Y */
	sw8 { gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>; };	/* X */
	sw11 { gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>; };	/* L3 */
	sw12 { gpios = <&gpio2 RK_PB6 GPIO_ACTIVE_LOW>; };	/* R3 */
	sw13 { gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>; };	/* FN */
	sw15 { gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>; };	/* L1 */
	sw16 { gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>; };	/* R1 */
	sw19 { gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>; };	/* select */
	sw20 { gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>; };	/* R2 */
	sw21 { gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>; };	/* L2 */
	sw22 { gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_LOW>; };	/* start */
};

/*
 * No rumble motor on the R36S rumble pin (GPIO0_B7) here, and stock turns
 * PWM0 off. The joypad driver still wants the PWM, so keep it running but
 * leave the pin a plain input.
 */
&pwm0 {
	pinctrl-0 = <&pwm0_pin_unused>;
};

&leds {
	/delete-node/ heartbeat;
	/delete-node/ vibrator;
};

/*
 * Blue on GPIO0_A0, red on GPIO0_C1, both lit is purple, both floating is
 * off (driving them low isn't). Was two gpio-leds on charging triggers.
 * Blue while on, like the green LED of the genuine R36S.
 */
&status_led {
	gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>, <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
	color-names = "off", "blue", "red", "purple";
	color-states = <2 2>, <1 2>, <2 1>, <1 1>;
	andr36oid,battery = "11 blue 0 red";
	andr36oid,charging = "red";
	andr36oid,full = "blue";
	/* run by boot.ini, so it is blue from power-on; U-Boot calls GPIO0_A0 a0 */
	andr36oid,u-boot = "gpio set a0";
	status = "okay";
};

&backlight {
	pwms = <&pwm1 0 25000 0>;
	/*
	 * At the lowest brightness the G80's backlight chip didn't always start
	 * again after the screen was off: a 20 ms pulse at 50 % wakes it first.
	 */
	andr36oid,kick-percent = <50>;
	andr36oid,kick-ms = <20>;
};

/*
 * The R36S DT turns on DDR at 786 MHz. The stock firmware of these boards,
 * the dArkOSRE ports and K4uanGP's andr36oid ports all leave it off.
 */
&dmc_opp_table {
	opp-786000000 {
		status = "disabled";
	};
};

&{/rk817-sound} {
	pinctrl-names = "default";
	pinctrl-0 = <&hp_det>;
};

&rk817 {
	charger {
		dc_det_gpio = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;
		/* reads "in" with nothing plugged in: also needs the PMIC to see power */
		andr36oid,dc-det-needs-power;
		/delete-property/ bat_low_gpio;	/* GPIO2_B5 is L3 here */
		max_input_current = <800>;
		max_chrg_current = <800>;
		chrg_finish_cur = <300>;
	};

	battery {
		/*
		 * Stock EmuELEC battery values of the G80 boards (stock DTB
		 * dumped from an R36S clone with Panel 5, E358874, and from the
		 * G30). The ArkOS DTBs for G80C/G80D boards and the dArkOSRE
		 * G80 ports use the same table and capacity.
		 */
		ocv_table = <3400 3445 3502 3552 3598 3637 3679
			3733 3782 3823 3865 3890 3904 3929
			3977 4017 4022 4038 4067 4123 4177>;
		design_capacity = <3124>;
		design_qmax = <3436>;
		bat_res = <119>;
		power_off_thresd = <3400>;
		zero_algorithm_vol = <3850>;
	};

	codec {
		spk-ctl-gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
	};
};

/* RK817 rails as set up by the stock firmware of these boards */
&vcc_3v3 {
	regulator-name = "vcc_3v0";
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;

	regulator-state-mem {
		regulator-suspend-microvolt = <3000000>;
	};
};

&vcc_1v0 {
	regulator-always-on;
	regulator-boot-on;
};

&vcc3v3_pmu {
	regulator-name = "vcc3v0_pmu";
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;

	regulator-state-mem {
		regulator-suspend-microvolt = <3000000>;
	};
};

&vccio_sd {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <3300000>;

	regulator-state-mem {
		regulator-suspend-microvolt = <3300000>;
	};
};

&vcc_sd {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;

	regulator-state-mem {
		regulator-suspend-microvolt = <3300000>;
	};
};

/* LDO7: I/O supply of the second card slot */
&vcc_backlight {
	regulator-name = "vccio_sd2";
	regulator-always-on;
	regulator-boot-on;
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <3300000>;

	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-suspend-microvolt = <3300000>;
	};
};

/* LDO8: card power of the second card slot, not the LCD */
&vcc_lcd {
	regulator-name = "vcc_sd2";
	regulator-always-on;
	regulator-boot-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;

	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-suspend-microvolt = <3300000>;
	};
};

/* LDO9 is a 1.5 V rail on these boards, never 3.3 V */
&vcc_wifi {
	regulator-name = "vdd1v5_dvp";
	regulator-min-microvolt = <1500000>;
	regulator-max-microvolt = <1500000>;

	regulator-state-mem {
		regulator-suspend-microvolt = <1500000>;
	};
};

&io_domains {
	vccio1-supply = <&vcc_backlight>;
	vccio2-supply = <&vccio_sd>;
	vccio3-supply = <&vcc1v8_soc>;
	vccio4-supply = <&vcc_3v3>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc1v8_soc>;
};

&sdio {
	cd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&vcc_lcd>;
	vqmmc-supply = <&vcc_backlight>;
	/* LDO7 can switch to 1.8 V here, so UHS works */
	/delete-property/ no-1-8-v;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
};

&dsi {
	panel@0 {
		reset-gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
		power-supply = <&vcc_lcd_sw>;
	};
};

&pmic_int {
	rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
};

/*
 * GPIO2_B4 is the stick mux enable on K36-type and V12 variant 2 boards. Our
 * U-Boot leaves it switched to UART2 TX (idle high, so the mux stays off) and
 * the GPIO driver does not switch it back, so set it to GPIO here. Unused on
 * the other EE boards.
 */
&btn_pins {
	rockchip,pins =
		<2 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>,
		<2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
		<2 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>;
};

&led_pins {
	rockchip,pins =
		<0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,
		<0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
};

&pinctrl {
	clone-ee {
		hp_det: hp-det {
			rockchip,pins = <2 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		pwm0_pin_unused: pwm0-pin-unused {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/*
 * The R36S debug UART (UART2 on pins M1) uses GPIO2_B4 and GPIO2_B6. On these
 * boards GPIO2_B6 is a button (and GPIO2_B4 the stick mux enable on K36), so
 * the joypad could not claim its pins and no button worked. The debug console
 * moves to UART5 (GPIO3_A1/A2) instead, like the stock firmware and dArkOS.
 */
&uart2 {
	status = "disabled";
};

&{/fiq-debugger} {
	rockchip,serial-id = <5>;
	pinctrl-0 = <&uart5_xfer>;
};
